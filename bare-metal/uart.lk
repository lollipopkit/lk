// A UART driver, written in LK.
//
// The device is the CMSDK APB UART that QEMU's MPS2 boards expose at
// 0x4000_4000. Its register block is small enough to drive completely:
//
//   +0x00  DATA     write transmits a byte
//   +0x04  STATE    bit 0 = TX buffer full
//   +0x08  CTRL     bit 0 = TX enable
//   +0x10  BAUDDIV  divisor; the device requires >= 16
//
// Every access goes through `volatile_write_u32` / `volatile_read_u32`. A
// device register is not memory: an ordinary read could be folded away or
// reordered against the writes that configure the device, and the status poll
// below would become an infinite loop the moment its read was hoisted.

const UART0_BASE = 0x40004000;

const REG_DATA = 0x00;
const REG_STATE = 0x04;
const REG_CTRL = 0x08;
const REG_BAUDDIV = 0x10;

const STATE_TX_FULL = 0x01;
const CTRL_TX_ENABLE = 0x01;

fn uart_init() {
    // Baud divisor before enabling: the device latches it at enable time.
    unsafe { volatile_write_u32((UART0_BASE + REG_BAUDDIV) as *mut u32, 16 as u32); };
    unsafe { volatile_write_u32((UART0_BASE + REG_CTRL) as *mut u32, CTRL_TX_ENABLE as u32); };
    // Both writes must land before any character is queued.
    unsafe { cpu_barrier(); };
}

fn uart_putc(byte: Int) {
    // Spin while the transmit holding register is full. This read has to
    // happen on every iteration — it is the canonical access that a
    // non-volatile load would let the compiler hoist, hanging the loop.
    let full = 1;
    while (full != 0) {
        let state = unsafe { volatile_read_u32((UART0_BASE + REG_STATE) as *mut u32) };
        // `as Int`: the mask is a `u32` because the register is, and `full` is
        // the loop's own Int flag. Stating the narrowing is what `lk check`
        // asks for — the embedded path never ran that check, so this file
        // disagreed with the checker for as long as it existed.
        full = (state & STATE_TX_FULL) as Int;
    }
    unsafe { volatile_write_u32((UART0_BASE + REG_DATA) as *mut u32, byte as u32); };
}

fn uart_write(bytes: List<Int>) {
    for byte in bytes {
        uart_putc(byte);
    }
}

// The SysTick timer, a Cortex-M core peripheral. Programming it is the other
// half of driving hardware: not just reading and writing a device, but arming
// the interrupt controller so the device can interrupt *us*.
//
//   0xE000_E010  CSR  bit 0 enable, bit 1 interrupt enable, bit 2 core clock
//   0xE000_E014  RVR  reload value (counts down from here)
//   0xE000_E018  CVR  current value; any write clears it
const SYST_CSR = 0xE000E010;
const SYST_RVR = 0xE000E014;
const SYST_CVR = 0xE000E018;

const SYST_ENABLE = 0x01;
const SYST_TICKINT = 0x02;
const SYST_CLKSOURCE = 0x04;

fn systick_start(reload: Int) {
    unsafe { volatile_write_u32(SYST_RVR as *mut u32, reload as u32); };
    // Clearing CVR is required before enabling, or the first period is
    // whatever the counter happened to hold.
    unsafe { volatile_write_u32(SYST_CVR as *mut u32, 0 as u32); };
    unsafe { cpu_barrier(); };
    let csr = SYST_ENABLE | SYST_TICKINT | SYST_CLKSOURCE;
    unsafe { volatile_write_u32(SYST_CSR as *mut u32, csr as u32); };
}

uart_init();
// "LK drives hardware\n"
uart_write([76, 75, 32, 100, 114, 105, 118, 101, 115, 32, 104, 97, 114, 100, 119, 97, 114, 101, 10]);

// Arm the timer, then do enough work for a few periods to elapse. Each tick
// prints a '.' from the interrupt handler.
systick_start(20000);
let spin = 0;
for i in 0..200000 {
    spin = spin + 1;
}
uart_putc(10);
return 0;
