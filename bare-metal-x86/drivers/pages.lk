// A page allocator: hand out 4 KiB pages from a range, and never take them
// back.
//
// Bump allocation, deliberately. A kernel this young has nothing that frees —
// the page tables, the heap and the framebuffer mapping all live for the whole
// run — and a free list would be machinery in service of a case that does not
// exist yet. What it does have to be is *honest about the range it was given*,
// which is why the caller passes one in rather than this file guessing.
//
// The state is three words at an address the caller chooses, because the
// interrupt handlers and the main flow both have to see the same allocator and
// a global would not be visible across that boundary.
//
//   +0  next page to hand out
//   +4  one past the last page
//   +8  pages handed out so far

const PAGE_SIZE = 4096;

fn pages_word(address: Int) -> Int {
    let value = unsafe { volatile_read_u32(address as *mut u32) };
    return value as Int;
}

fn pages_set_word(address: Int, value: Int) {
    unsafe { volatile_write_u32(address as *mut u32, value as u32); };
}

// Rounds `base` up and `base + length` down to page boundaries, so a range
// that starts mid-page never hands out an address below where it began.
fn init(state: Int, base: Int, length: Int) {
    let first = ((base + PAGE_SIZE - 1) / PAGE_SIZE) as Int;
    let last = ((base + length) / PAGE_SIZE) as Int;
    pages_set_word(state, first);
    pages_set_word(state + 4, last);
    pages_set_word(state + 8, 0);
}

// The next page's physical address, or 0 when the range is exhausted. Zero is
// unambiguous: page 0 is never in a range this hands out, because the first
// megabyte is not usable memory.
fn alloc(state: Int) -> Int {
    let next = pages_word(state);
    if (next >= pages_word(state + 4)) {
        return 0;
    }
    pages_set_word(state, next + 1);
    pages_set_word(state + 8, pages_word(state + 8) + 1);
    return next * PAGE_SIZE;
}

fn used(state: Int) -> Int {
    return pages_word(state + 8);
}

fn free(state: Int) -> Int {
    return pages_word(state + 4) - pages_word(state);
}

fn total(state: Int) -> Int {
    return free(state) + used(state);
}
