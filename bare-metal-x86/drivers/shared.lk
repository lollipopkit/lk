// A word an interrupt handler and the main flow can both see.
//
// A plain global would not do: the compiler may keep one in a register across
// a polling loop, and an interrupt writing memory would never be seen. So
// these go through `volatile_read_u32` / `volatile_write_u32` — the same
// reason a device register needs `volatile`, applied to ordinary memory that
// changes behind the code's back.
//
// The addresses are the caller's to choose, and on a board with no memory
// manager they are simply free RAM.

fn read(address: Int) -> Int {
    let value = unsafe { volatile_read_u32(address as *mut u32) };
    return value as Int;
}

fn write(address: Int, value: Int) {
    unsafe { volatile_write_u32(address as *mut u32, value as u32); };
}

// Read, add, write — three steps that an interrupt can land between, and the
// increment that lands there is lost. The caller holds a critical section, so
// this does not take one itself: a bump is usually part of a larger update
// that has to be atomic as a whole, and a lock per word would give the false
// impression that each is.
fn bump(address: Int) -> Int {
    let next = read(address) + 1;
    write(address, next);
    return next;
}

// Byte-wide access, for the character buffers an interrupt handler fills.
//
// A handler cannot allocate — an interrupt lands between any two instructions,
// including instructions inside the runtime's allocator — so a line of text it
// collects has to live somewhere fixed, one byte at a time.

fn read_byte(address: Int) -> Int {
    let value = unsafe { volatile_read_u8(address as *mut u8) };
    return value as Int;
}

fn write_byte(address: Int, value: Int) {
    unsafe { volatile_write_u8(address as *mut u8, value as u8); };
}
