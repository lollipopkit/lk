// A linear framebuffer.
//
// Nothing device-specific: given a base address and a stride, this is an array
// of 32-bit pixels reached through volatile MMIO. Which device it belongs to,
// and what mode it is in, are the caller's business — see `drivers/vbe` and
// `drivers/pci`.

fn put_pixel(base: Int, stride: Int, x: Int, y: Int, colour: Int) {
    let offset = (y * stride + x) * 4;
    unsafe { volatile_write_u32((base + offset) as *mut u32, colour as u32); };
}

fn get_pixel(base: Int, stride: Int, x: Int, y: Int) -> Int {
    let offset = (y * stride + x) * 4;
    let value = unsafe { volatile_read_u32((base + offset) as *mut u32) };
    return value as Int;
}

fn fill_rect(base: Int, stride: Int, left: Int, top: Int, width: Int, height: Int, colour: Int) {
    for y in 0..height {
        for x in 0..width {
            put_pixel(base, stride, left + x, top + y, colour);
        }
    }
}

// A red/green ramp: red rises left to right, green top to bottom. Integer
// `/` is float division in LK, so each ramp is cast back — without that the
// colour reaching `put_pixel` is a Float where an Int was declared, which the
// type checker now says so about.
fn fill_gradient(base: Int, width: Int, height: Int, blue: Int) {
    for y in 0..height {
        let green = (((y * 255) as Int) / height) as Int;
        for x in 0..width {
            let red = (((x * 255) as Int) / width) as Int;
            put_pixel(base, width, x, y, red * 0x10000 + green * 0x100 + blue);
        }
    }
}

// Two adjacent pixels at once.
//
// A pixel is four bytes and the framebuffer is contiguous, so a 64-bit access
// carries two of them. Each of these accessors is an opaque call into the
// runtime — they have to be, or the optimiser would collapse repeated reads of
// device memory — so halving the *number* of calls halves most of the cost of
// moving a picture around.
fn get_pixel_pair(base: Int, stride: Int, x: Int, y: Int) -> Int {
    let offset = (y * stride + x) * 4;
    let value = unsafe { volatile_read_u64((base + offset) as *mut u64) };
    return value as Int;
}

fn put_pixel_pair(base: Int, stride: Int, x: Int, y: Int, pair: Int) {
    let offset = (y * stride + x) * 4;
    unsafe { volatile_write_u64((base + offset) as *mut u64, pair as u64); };
}
