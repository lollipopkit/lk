// The Bochs VBE display interface, which QEMU's standard VGA implements.
//
// The Bochs VBE interface, which QEMU's standard VGA implements: an index port
// and a data port, both 16-bit. Setting a mode means disabling the device,
// writing the geometry, then re-enabling it with the linear-framebuffer bit —
// the device latches the geometry at enable time.

const VBE_INDEX = 0x1ce;
const VBE_DATA = 0x1cf;

const VBE_XRES = 1;
const VBE_YRES = 2;
const VBE_BPP = 3;
const VBE_ENABLE = 4;

const VBE_DISABLED = 0x00;
const VBE_ENABLED = 0x01;
const VBE_LFB = 0x40;

fn vbe_write(index: Int, value: Int) {
    unsafe { port_out_u16(VBE_INDEX, index as u16); };
    unsafe { port_out_u16(VBE_DATA, value as u16); };
}

fn vbe_set_mode(width: Int, height: Int, depth: Int) {
    vbe_write(VBE_ENABLE, VBE_DISABLED);
    vbe_write(VBE_XRES, width);
    vbe_write(VBE_YRES, height);
    vbe_write(VBE_BPP, depth);
    vbe_write(VBE_ENABLE, VBE_ENABLED | VBE_LFB);
}
