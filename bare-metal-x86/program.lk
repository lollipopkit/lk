// A small kernel, written in LK, compiled to native x86-64 machine code and
// running with no OS underneath.
//
// The device drivers are modules under `drivers/` — a UART, PCI configuration
// space, the VBE display interface, a framebuffer, the PS/2 keyboard, the
// interval timer. Each is self-contained and knows nothing about this program;
// what is left here is the part that is not reusable: which devices to bring
// up, in what order, and what a keystroke means.
//
// The two interrupt handlers are `#[export]`ed so the board's IDT can name
// them. They live here rather than in the driver modules for the same reason:
// a driver decodes a scancode, but only the program knows what to do with it.

use { uart_init, uart_putc, uart_write, uart_put_int, uart_put_hex, pow2 } from "drivers/serial";
use { pci_read, pci_write, pci_find_display, PCI_REG_BAR0, PCI_REG_COMMAND,
      PCI_COMMAND_MEMORY, PCI_COMMAND_BUS_MASTER } from "drivers/pci";
use { vbe_set_mode } from "drivers/vbe";
use { get_pixel } from "drivers/framebuffer";
use { draw_glyph, draw_cells, clear, scroll_up, draw_cursor, CELL_WIDTH, CELL_HEIGHT } from "drivers/text";
use { read_scancode, is_release, key_code } from "drivers/keyboard";
use { start as pit_start } from "drivers/pit";
use { acquire as lock, release as unlock } from "drivers/lock";
use { define as window_define, put as window_put, fill as window_fill,
      dropped as window_dropped, outline as window_outline } from "drivers/window";
use { glyph_row, glyph_width, glyph_rows } from "drivers/text";
use { reset as queue_reset, push as queue_push, pop as queue_pop,
      is_empty as queue_empty } from "drivers/queue";
use { has_mmap, mem_upper_kb, entry_count, entry_at, entry_base, entry_length,
      entry_is_available } from "drivers/multiboot";
use { init as pages_init, alloc as page_alloc, free as pages_free,
      total as pages_total, PAGE_SIZE } from "drivers/pages";
use { read as shared_read, write as shared_write, bump as shared_bump,
      read_byte as shared_read_byte, write_byte as shared_write_byte } from "drivers/shared";

const WIDTH = 320;
const HEIGHT = 200;

const BACKGROUND = 0x001428;
const FOREGROUND = 0x40ff90;
const TITLE_COLOUR = 0xffc040;
const CURSOR_COLOUR = 0x205070;

// A 5x7 font in an 8-row cell, one row per integer with the leftmost pixel in
// bit 4. Written for this program rather than taken from anywhere, so the
// repository carries no third-party font data.
//
// It lives here rather than in `drivers/text` because a container at a
// module's top level cannot cross a bundled import without changing what the
// VM would do — see that module's comment.
const FONT = [
     0,  0,  0,  0,  0,  0,  0,  0,  // space
    14, 17, 17, 31, 17, 17, 17,  0,  // A
    30, 17, 30, 17, 17, 17, 30,  0,  // B
    15, 16, 16, 16, 16, 16, 15,  0,  // C
    30, 17, 17, 17, 17, 17, 30,  0,  // D
    31, 16, 30, 16, 16, 16, 31,  0,  // E
    31, 16, 30, 16, 16, 16, 16,  0,  // F
    15, 16, 16, 19, 17, 17, 15,  0,  // G
    17, 17, 31, 17, 17, 17, 17,  0,  // H
    14,  4,  4,  4,  4,  4, 14,  0,  // I
     7,  2,  2,  2,  2, 18, 12,  0,  // J
    17, 18, 20, 24, 20, 18, 17,  0,  // K
    16, 16, 16, 16, 16, 16, 31,  0,  // L
    17, 27, 21, 17, 17, 17, 17,  0,  // M
    17, 25, 21, 19, 17, 17, 17,  0,  // N
    14, 17, 17, 17, 17, 17, 14,  0,  // O
    30, 17, 17, 30, 16, 16, 16,  0,  // P
    14, 17, 17, 17, 21, 18, 13,  0,  // Q
    30, 17, 17, 30, 20, 18, 17,  0,  // R
    15, 16, 16, 14,  1,  1, 30,  0,  // S
    31,  4,  4,  4,  4,  4,  4,  0,  // T
    17, 17, 17, 17, 17, 17, 14,  0,  // U
    17, 17, 17, 17, 17, 10,  4,  0,  // V
    17, 17, 17, 17, 21, 27, 17,  0,  // W
    17, 17, 10,  4, 10, 17, 17,  0,  // X
    17, 17, 10,  4,  4,  4,  4,  0,  // Y
    31,  1,  2,  4,  8, 16, 31,  0,  // Z
    14, 17, 19, 21, 25, 17, 14,  0,  // 0
     4, 12,  4,  4,  4,  4, 14,  0,  // 1
    14, 17,  1,  2,  4,  8, 31,  0,  // 2
    31,  2,  6,  1,  1, 17, 14,  0,  // 3
     2,  6, 10, 18, 31,  2,  2,  0,  // 4
    31, 16, 30,  1,  1, 17, 14,  0,  // 5
     6,  8, 16, 30, 17, 17, 14,  0,  // 6
    31,  1,  2,  4,  8,  8,  8,  0,  // 7
    14, 17, 17, 14, 17, 17, 14,  0,  // 8
    14, 17, 17, 15,  1,  2, 12,  0,  // 9
     0,  0,  0,  0,  0, 12, 12,  0,  // .
     0,  0,  0,  0, 12, 12,  8,  0,  // ,
     0, 12, 12,  0, 12, 12,  0,  0,  // :
     0,  0,  0, 31,  0,  0,  0,  0,  // -
     4,  4,  4,  4,  4,  0,  4,  0,  // !
    14, 17,  1,  2,  4,  0,  4,  0,  // ?
     0,  0, 31,  0, 31,  0,  0,  0,  // =
     0, 16,  8,  4,  8, 16,  0,  0,  // >
];

// Free RAM: the image, its heap, its stack and the page tables all live below
// 2 MiB. Crude, and deliberately so — a kernel with no memory manager yet has
// exactly this much to work with.
// Scancode set 1 for a US layout, enough of it to spell things. Index is the
// scancode; 0 means "nothing printable", which covers modifiers and the keys
// not listed. It lives here rather than in the driver because it is a layout
// choice, and because a container constant cannot yet cross a bundled import.
const SCANCODE_ASCII = [
    0, 0, 49, 50, 51, 52, 53, 54, 55, 56, 57, 48, 45, 61, 8, 9,
    113, 119, 101, 114, 116, 121, 117, 105, 111, 112, 91, 93, 10, 0,
    97, 115, 100, 102, 103, 104, 106, 107, 108, 59, 39, 96, 0, 92,
    122, 120, 99, 118, 98, 110, 109, 44, 46, 47, 0, 42, 0, 32,
];

const SHARED_KEY_COUNT = 0x00300000;
const SHARED_LAST_KEY = 0x00300004;
const SHARED_TICKS = 0x00300008;
const SHARED_CURSOR_COL = 0x0030000c;
const SHARED_CURSOR_ROW = 0x00300010;
const SHARED_LINE_LEN = 0x00300014;
const SHARED_LINE_READY = 0x00300018;
// The line the handler is collecting. One byte per character, because a
// handler cannot allocate.
// Where `boot.rs` stashed the multiboot information pointer. The board writes
// it, this program reads it; the address appears in both files, and changing
// one without the other is the hazard.
const SHARED_MULTIBOOT = 0x0030001c;
// The page allocator's three words.
const SHARED_PAGES = 0x00300020;
// The spinner task's step, and the scheduler's own counter.
const SHARED_SPIN = 0x00300024;
const SHARED_SLICE = 0x00300028;
// Two words that must always agree. Both the timer handler and the spinner
// task bump the pair; a lost update — an increment that read a stale value —
// leaves them different, which no amount of interleaving can otherwise do.
const SHARED_PAIR_A = 0x0030002c;
const SHARED_PAIR_B = 0x00300030;
// Window descriptors: slot 0 is the shell's, slot 1 the spinner's.
const SHARED_WINDOWS = 0x00300040;
const WINDOW_SHELL = 0;
const WINDOW_SPINNER = 1;
// Which window the keyboard belongs to. Tab moves it.
const SHARED_FOCUS = 0x00300034;
// One input ring per window, 64 bytes apart.
const SHARED_QUEUES = 0x00300200;
const QUEUE_STRIDE = 64;
// Where the spinner window's own echo has got to, in its own coordinates.
const SHARED_PANE_COL = 0x00300038;
// What each window last drew its frame as. Repainting is the owner's job — the
// key handler only records that the focus moved, because a handler has no
// business drawing someone else's chrome.
const SHARED_DRAWN_FOCUS = 0x0030003c;

const FRAME_IDLE = 0x203040;
const FRAME_FOCUSED = 0xffc040;
const SHARED_LINE = 0x00300100;
const LINE_CAPACITY = 48;

// Where a character sits in FONT. The font has one case, so lower-case maps to
// the upper-case glyph; anything it does not cover renders as a space, which
// is what a terminal with a small font should do rather than drawing noise.
fn glyph_index(ascii: Int) -> Int {
    if (ascii >= 65 && ascii <= 90) { return 1 + ascii - 65; }
    if (ascii >= 97 && ascii <= 122) { return 1 + ascii - 97; }
    if (ascii >= 48 && ascii <= 57) { return 27 + ascii - 48; }
    if (ascii == 46) { return 37; }
    if (ascii == 44) { return 38; }
    if (ascii == 58) { return 39; }
    if (ascii == 45) { return 40; }
    if (ascii == 33) { return 41; }
    if (ascii == 63) { return 42; }
    if (ascii == 61) { return 43; }
    if (ascii == 62) { return 44; }
    return 0;
}

fn text_columns() -> Int { return ((WIDTH / CELL_WIDTH) as Int); }
fn text_rows() -> Int { return ((HEIGHT / CELL_HEIGHT) as Int); }

// Ask PCI where the framebuffer is. Two port accesses, cheap enough to repeat —
// and repeating it keeps the interrupt handler independent of whether the main
// flow has run yet.
fn framebuffer_address() -> Int {
    let slot = pci_find_display();
    return pci_read(slot, PCI_REG_BAR0) & 0xfffffff0;
}

// Draws one character at the cursor and moves it, or acts on backspace and
// newline.
//
// Shared by the interrupt handler and the command output, because "put a
// character on the screen" is the same operation whoever asks. Callers that
// are not the handler mask interrupts around it: the two would otherwise
// interleave on the cursor.
fn put_char(base: Int, ascii: Int) {
    let column = shared_read(SHARED_CURSOR_COL);
    let row = shared_read(SHARED_CURSOR_ROW);
    // Erase the cursor before anything moves it, so the block never gets left
    // behind on the cell it used to occupy.
    draw_cursor(base, WIDTH, column, row, BACKGROUND);

    if (ascii == 8) {
        // Backspace stops at the left margin rather than wrapping to the
        // previous line: nothing here records where that line ended.
        if (column > 0) {
            let back = column - 1;
            draw_glyph(base, WIDTH, FONT, 0, back * CELL_WIDTH, row * CELL_HEIGHT, FOREGROUND, BACKGROUND);
            place_cursor(base, back, row);
        } else {
            place_cursor(base, column, row);
        }
        return;
    }
    if (ascii == 10) {
        advance_line(base, row);
        return;
    }
    draw_glyph(base, WIDTH, FONT, glyph_index(ascii),
               column * CELL_WIDTH, row * CELL_HEIGHT, FOREGROUND, BACKGROUND);
    let next = column + 1;
    if (next >= text_columns()) {
        advance_line(base, row);
    } else {
        place_cursor(base, next, row);
    }
}

// Records the cursor position and draws it.
fn place_cursor(base: Int, column: Int, row: Int) {
    shared_write(SHARED_CURSOR_COL, column);
    shared_write(SHARED_CURSOR_ROW, row);
    draw_cursor(base, WIDTH, column, row, CURSOR_COLOUR);
}

// Moves to the start of the next line, scrolling when there is no next line.
//
// Scrolling rather than wrapping to the top: a terminal that overwrites its
// own first line is harder to read than one that loses the oldest.
fn advance_line(base: Int, row: Int) {
    let next = row + 1;
    if (next >= text_rows()) {
        scroll_up(base, WIDTH, HEIGHT, BACKGROUND);
        place_cursor(base, 0, text_rows() - 1);
    } else {
        place_cursor(base, 0, next);
    }
}

// ------------------------------------------------------------- commands ---
//
// The line the handler collected is a run of bytes in the shared page, so the
// commands are matched byte-wise against literal spellings rather than through
// string values. That is not a workaround: it is the same code whether it runs
// before there is a heap or after.

// Writes a run of ASCII to both the screen and the serial line.
//
// Interrupts are masked by the caller: this shares the cursor with the key
// handler, and the two interleaving would splice the output.
fn emit(base: Int, text: List<Int>) {
    for code in text {
        let ascii = (code) as Int;
        uart_putc(ascii);
        put_char(base, ascii);
    }
    uart_putc(10);
    put_char(base, 10);
}

// Whether the collected line starts with `word`, and what follows it.
fn line_starts_with(word: List<Int>) -> Bool {
    let length = shared_read(SHARED_LINE_LEN);
    if (length < word.len()) {
        return false;
    }
    for i in 0..word.len() {
        if (shared_read_byte(SHARED_LINE + i) != ((word[i]) as Int)) {
            return false;
        }
    }
    // A prefix only counts as the whole word when the line ends there or a
    // space follows — otherwise `echoes` would answer to `echo`.
    if (length == word.len()) {
        return true;
    }
    return shared_read_byte(SHARED_LINE + word.len()) == 32;
}

// The line's bytes from `start` onwards. (`from` is a keyword.)
fn line_tail(start: Int) -> List<Int> {
    let out = [0];
    let length = shared_read(SHARED_LINE_LEN);
    let i = start;
    while (i < length) {
        out.push(shared_read_byte(SHARED_LINE + i));
        i = i + 1;
    }
    return out.slice(1, out.len());
}

fn hex(value: Int) -> List<Int> {
    let out = [0];
    let shift = 28;
    while (shift >= 0) {
        let nibble = ((value / pow2(shift)) as Int) & 0xf;
        if (nibble < 10) {
            out.push(48 + nibble);
        } else {
            out.push(87 + nibble);
        }
        shift = shift - 4;
    }
    return out.slice(1, out.len());
}

fn decimal(value: Int) -> List<Int> {
    if (value == 0) {
        return [48];
    }
    let digits = [0];
    let rest = value;
    while (rest > 0) {
        digits.push(48 + rest % 10);
        rest = (rest / 10) as Int;
    }
    let out = [0];
    let i = digits.len() - 1;
    while (i >= 1) {
        out.push((digits[i]) as Int);
        i = i - 1;
    }
    return out.slice(1, out.len());
}

// The largest available range the loader reported, as (base, length).
//
// Largest rather than first: the map's usable ranges are the one below 640 KiB
// and the one above 1 MiB, and only the second is worth allocating from.
fn largest_available_base() -> Int {
    let best_base = 0;
    let best_length = 0;
    for i in 0..entry_count() {
        let entry = entry_at(i);
        if (entry >= 0 && entry_is_available(entry)) {
            let length = entry_length(entry);
            if (length > best_length) {
                best_length = length;
                best_base = entry_base(entry);
            }
        }
    }
    return best_base;
}

fn largest_available_length() -> Int {
    let best_length = 0;
    for i in 0..entry_count() {
        let entry = entry_at(i);
        if (entry >= 0 && entry_is_available(entry)) {
            let length = entry_length(entry);
            if (length > best_length) {
                best_length = length;
            }
        }
    }
    return best_length;
}

fn report_memory(base: Int) {
    if (!has_mmap()) {
        // "no map"
        emit(base, [110, 111, 32, 109, 97, 112]);
        return;
    }
    // "upper " KiB
    let upper = [117, 112, 112, 101, 114, 32];
    emit(base, upper.chain(decimal(mem_upper_kb())).chain([32, 107, 98]));
    // "pages " free "/" total
    let pages = [112, 97, 103, 101, 115, 32];
    emit(base, pages.chain(decimal(pages_free(SHARED_PAGES)))
                    .chain([47])
                    .chain(decimal(pages_total(SHARED_PAGES))));
}

// Runs the collected line. Returns 1 to keep going, 0 to stop.
fn run_command(base: Int) -> Int {
    let length = shared_read(SHARED_LINE_LEN);
    if (length == 0) {
        return 1;
    }
    if (line_starts_with([104, 101, 108, 112])) {          // "help"
        // "help clear echo keys exit"
        // "help clear echo keys mem page sync yield win time exit"
        emit(base, [104, 101, 108, 112, 32, 99, 108, 101, 97, 114, 32, 101, 99,
                    104, 111, 32, 107, 101, 121, 115, 32, 109, 101, 109, 32,
                    112, 97, 103, 101, 32, 115, 121, 110, 99, 32,
                    121, 105, 101, 108, 100, 32, 119, 105, 110, 32,
                    116, 105, 109, 101, 32, 101, 120, 105, 116]);
        return 1;
    }
    if (line_starts_with([99, 108, 101, 97, 114])) {       // "clear"
        clear(base, WIDTH, HEIGHT, BACKGROUND);
        place_cursor(base, 0, 0);
        return 1;
    }
    if (line_starts_with([101, 99, 104, 111])) {           // "echo"
        emit(base, line_tail(5));
        return 1;
    }
    if (line_starts_with([107, 101, 121, 115])) {          // "keys"
        emit(base, decimal(shared_read(SHARED_KEY_COUNT)));
        return 1;
    }
    if (line_starts_with([109, 101, 109])) {               // "mem"
        report_memory(base);
        return 1;
    }
    if (line_starts_with([112, 97, 103, 101])) {           // "page"
        let address = page_alloc(SHARED_PAGES);
        if (address == 0) {
            // "none"
            emit(base, [110, 111, 110, 101]);
        } else {
            emit(base, hex(address));
        }
        return 1;
    }
    if (line_starts_with([115, 121, 110, 99])) {           // "sync"
        let state = lock();
        let a = shared_read(SHARED_PAIR_A);
        let b = shared_read(SHARED_PAIR_B);
        unlock(state);
        emit(base, decimal(a).chain([47]).chain(decimal(b)));
        return 1;
    }
    if (line_starts_with([121, 105, 101, 108, 100])) {     // "yield"
        task_yield();
        // "back"
        emit(base, [98, 97, 99, 107]);
        return 1;
    }
    if (line_starts_with([119, 105, 110])) {               // "win"
        emit(base, decimal(window_dropped(SHARED_WINDOWS, WINDOW_SPINNER)));
        return 1;
    }
    if (line_starts_with([116, 105, 109, 101])) {          // "time"
        // Measure the two things this program does that are not cheap: a
        // scroll moves the whole picture a pixel row at a time, and a focus
        // change repaints both frames. Both run with interrupts masked, so
        // what they cost is time the other task does not get.
        let irq_time = lock();
        let t0 = unsafe { cpu_timestamp() };
        scroll_up(base, WIDTH, HEIGHT, BACKGROUND);
        let t1 = unsafe { cpu_timestamp() };
        repaint_frame(base, WINDOW_SHELL);
        repaint_frame(base, WINDOW_SPINNER);
        let t2 = unsafe { cpu_timestamp() };
        unlock(irq_time);
        // "scroll " cycles " frames " cycles
        emit(base, [115, 99, 114, 111, 108, 108, 32]
                   .chain(decimal((t1 as Int) - (t0 as Int)))
                   .chain([32, 102, 114, 97, 109, 101, 115, 32])
                   .chain(decimal((t2 as Int) - (t1 as Int))));
        return 1;
    }
    if (line_starts_with([101, 120, 105, 116])) {          // "exit"
        // "bye"
        emit(base, [98, 121, 101]);
        return 0;
    }
    // "?"
    emit(base, [63]);
    return 1;
}

// ---------------------------------------------------------------- tasks ---

// Give up the rest of this task's slice.
//
// `#[extern]` is the mirror of `#[export]`: the board implements this, and a
// native build calls that symbol. The body below is what the *interpreter*
// runs — it has no way to reach the outside implementation — so it does the
// only honest thing a single-threaded interpreter can do about yielding, which
// is nothing.
//
// That also means this function is where the two back ends stop agreeing by
// construction. Everything else in LK is checked against the VM; a call to
// something the program does not contain cannot be.
#[extern("kernel_yield")]
fn task_yield() {
}

// Repaints a window's frame if the focus has moved since it last did.
//
// Each window does this for itself, on its own turn. The key handler that
// moved the focus only wrote a word: drawing from an interrupt would put a
// window's appearance in the hands of whatever happened to be interrupted.
fn repaint_frame(base: Int, slot: Int) {
    let focus = shared_read(SHARED_FOCUS);
    let colour = FRAME_IDLE;
    if (focus == slot) {
        colour = FRAME_FOCUSED;
    }
    window_outline(base, WIDTH, SHARED_WINDOWS, slot, colour);
}

// Draws a glyph inside a window, in window coordinates.
//
// The glyph's bit rows come from `drivers/text`; the pixels go through
// `drivers/window`, so anything outside the rectangle is dropped rather than
// landing in someone else's part of the screen.
fn draw_glyph_in_window(base: Int, slot: Int, index: Int, x: Int, y: Int) {
    for row in 0..glyph_rows() {
        let bits = glyph_row(FONT, index, row);
        for column in 0..glyph_width() {
            let shift = glyph_width() - 1 - column;
            let lit = ((bits / pow2(shift)) as Int) & 1;
            let colour = BACKGROUND;
            if (lit != 0) {
                colour = TITLE_COLOUR;
            }
            window_put(base, WIDTH, SHARED_WINDOWS, slot, x + column, y + row, colour);
        }
    }
}

// Bumps the two words that must agree, as one indivisible step.
//
// The pair exists to make a lost update *visible*. Read-modify-write is three
// steps; an interrupt landing between the read and the write discards whatever
// happened in between. With both parties doing it under the same section, the
// two words can only ever come out equal.
fn bump_pair() {
    let state = lock();
    shared_bump(SHARED_PAIR_A);
    shared_bump(SHARED_PAIR_B);
    unlock(state);
}

// Which task runs next.
//
// The board owns the registers and the stacks; this owns the policy. Round
// robin, because there is nothing yet to prioritise — but the *shape* is where
// a real policy would go, and it is LK.
//
// Called from the timer interrupt with everything already saved, so it must
// not allocate: `lkrt` has one arena and no lock around it.
#[export("lk_schedule")]
fn schedule(current: Int) -> Int {
    // Give each task a few ticks rather than switching every millisecond: a
    // switch costs a stack's worth of pushes, and a slice this short would
    // spend more time switching than running.
    let slice = shared_bump(SHARED_SLICE);
    if (slice % 8 != 0) {
        return current;
    }
    if (current == 0) {
        return 1;
    }
    return 0;
}

// The second task: a spinner in the top-right corner.
//
// It never returns and never yields — the timer takes the CPU away from it.
// That is what makes it a demonstration rather than a callback: nothing here
// cooperates.
#[export("lk_task_b")]
fn task_b() {
    while (true) {
        // Its own input, when it has the focus. Drawn in its own window, in
        // its own coordinates — nothing here can reach the shell's pixels
        // even if the arithmetic is wrong.
        let irq_in = lock();
        while (!queue_empty(SHARED_QUEUES + WINDOW_SPINNER * QUEUE_STRIDE)) {
            let typed = queue_pop(SHARED_QUEUES + WINDOW_SPINNER * QUEUE_STRIDE);
            let column = shared_read(SHARED_PANE_COL);
            if (typed == 10) {
                column = 0;
            } else {
                draw_glyph_in_window(framebuffer_address(), WINDOW_SPINNER,
                                     glyph_index(typed), 1 + column * CELL_WIDTH, CELL_HEIGHT + 1);
                column = column + 1;
            }
            shared_write(SHARED_PANE_COL, column % 10);
        }
        unlock(irq_in);

        let step = shared_bump(SHARED_SPIN);
        // Four glyph indices, chosen without a list: building one here would
        // allocate, and a task may not — `lkrt` has a single arena with no
        // lock around it, so two tasks inside it at once corrupt it.
        let phase = step % 4;
        // Four *distinct* glyphs: a repeat would make consecutive frames
        // compare equal, which is exactly what a test for "it advanced" reads.
        let face = 40;                   // '-'
        if (phase == 1) { face = 12; }   // 'L'
        if (phase == 2) { face = 11; }   // 'K'
        if (phase == 3) { face = 39; }   // ':'

        // Through the window, in window coordinates. The spinner owns one
        // cell; everything it draws is either inside that cell or dropped.
        let base = framebuffer_address();
        draw_glyph_in_window(base, WINDOW_SPINNER, face, 1, 1);
        // And deliberately one cell to the left, which is *not* its window.
        // Without the rectangle this would land in the shell's text; with it,
        // the pixels are counted and discarded.
        draw_glyph_in_window(base, WINDOW_SPINNER, face, 0 - glyph_width() - 1, 1);
        // Contend with the timer handler on the same pair of words for a
        // while — this task exists to be interrupted, and to be interrupted
        // *in the middle of an update*.
        // Enough to have the timer land inside an update many times over,
        // but short enough that the face advances several times a second —
        // a test that samples the screen needs the change to be visible
        // without waiting.
        for i in 0..4000 {
            bump_pair();
        }
        // Then hand the CPU back rather than waiting to be taken off it.
        task_yield();
    }
}

// The timer interrupt handler.
//
// Divided down: at a kilohertz, one character per tick is thousands of them.
// The counter lives in the shared page because a handler's state has to
// survive between invocations, and it is the only state this one keeps.
#[export("lk_timer_isr")]
fn on_tick() {
    bump_pair();
    let ticks = shared_bump(SHARED_TICKS);
    if (ticks % 500 == 0) {
        uart_putc(46); // '.'
    }
}

// The keyboard interrupt handler.
//
// It reads the controller itself: what the board owes the device is the
// acknowledgement, but the scancode is the driver's business. It transmits
// directly and allocates nothing — an interrupt lands between any two
// instructions of the interrupted program, including instructions inside the
// runtime's allocator.
#[export("lk_key_isr")]
fn on_key() {
    let scancode = read_scancode();
    if (is_release(scancode)) {
        return;
    }
    let code = key_code(scancode);
    if (code >= SCANCODE_ASCII.len()) {
        return;
    }
    // `as Int` is not decoration. A global that an `#[export]`ed function
    // reads is treated as dynamic — nothing proves the entry ran before an
    // interrupt did — so the table's element arrives boxed. The cast is where
    // the program states what it knows.
    let ascii = (SCANCODE_ASCII[code]) as Int;
    if (ascii == 0) {
        return;
    }
    shared_bump(SHARED_KEY_COUNT);
    shared_write(SHARED_LAST_KEY, ascii);
    uart_putc(ascii);

    // Tab is the board's, not any window's: it moves the focus.
    if (ascii == 9) {
        let focus = shared_read(SHARED_FOCUS);
        if (focus == WINDOW_SHELL) {
            shared_write(SHARED_FOCUS, WINDOW_SPINNER);
        } else {
            shared_write(SHARED_FOCUS, WINDOW_SHELL);
        }
        return;
    }

    // Everything else goes to whoever has the focus. The handler does not know
    // what a keystroke *means* — that is the window's business, and the window
    // runs in a task where allocating and printing are allowed.
    let focus = shared_read(SHARED_FOCUS);
    queue_push(SHARED_QUEUES + focus * QUEUE_STRIDE, ascii);
}

uart_init();
// ~1 kHz. The board has already unmasked IRQ0 and enabled interrupts; what
// this decides is how often it fires.
pit_start(1193);

let slot = pci_find_display();
let framebuffer = framebuffer_address();

// Let the device answer to memory cycles at all. The firmware usually has
// already, but a driver that depends on that is a driver that works on one
// machine.
let command = pci_read(slot, PCI_REG_COMMAND);
pci_write(slot, PCI_REG_COMMAND, command | PCI_COMMAND_MEMORY | PCI_COMMAND_BUS_MASTER);

vbe_set_mode(WIDTH, HEIGHT, 32);
clear(framebuffer, WIDTH, HEIGHT, BACKGROUND);

// Glyph indices rather than ASCII: these are constants, so translating them at
// run time would be work the program already knows the answer to.
//   "LK ON BARE METAL"
draw_cells(framebuffer, WIDTH, FONT,
           [12, 11, 0, 15, 14, 0, 2, 1, 18, 5, 0, 13, 5, 20, 1, 12],
           1, 1, TITLE_COLOUR, BACKGROUND);
//   "TYPE HELP" then the prompt on the next line
draw_cells(framebuffer, WIDTH, FONT, [20, 25, 16, 5, 0, 8, 5, 12, 16], 1, 3, FOREGROUND, BACKGROUND);
draw_cells(framebuffer, WIDTH, FONT, [44], 1, 5, FOREGROUND, BACKGROUND);

// Hand the page allocator the biggest usable range the loader reported. The
// image, its stack and its page tables all sit below 2 MiB, so the range is
// trimmed to start there rather than on top of them.
let ram_base = largest_available_base();
let ram_length = largest_available_length();
let usable_base = ram_base;
if (usable_base < 0x00400000) {
    usable_base = 0x00400000;
}
pages_init(SHARED_PAGES, usable_base, ram_length - (usable_base - ram_base));

// Two windows: the shell owns everything but the corner cell the spinner has.
// Nothing enforces that they were carved up sensibly — what the rectangles buy
// is that neither can write into the other's, however wrong the coordinates
// inside them are.
window_define(SHARED_WINDOWS, WINDOW_SHELL, 0, 0, WIDTH, HEIGHT);
// Ten cells wide and two tall: the top row is the spinner, the row below is
// what this pane echoes when it has the focus.
// Two pixels wider and taller than its content, so the one-pixel frame it
// draws for itself does not eat into a glyph.
window_define(SHARED_WINDOWS, WINDOW_SPINNER,
              (text_columns() - 11) * CELL_WIDTH, 0, 10 * CELL_WIDTH + 2, 2 * CELL_HEIGHT + 2);
queue_reset(SHARED_QUEUES + WINDOW_SHELL * QUEUE_STRIDE);
queue_reset(SHARED_QUEUES + WINDOW_SPINNER * QUEUE_STRIDE);
shared_write(SHARED_FOCUS, WINDOW_SHELL);
shared_write(SHARED_PANE_COL, 0);
shared_write(SHARED_DRAWN_FOCUS, 0 - 1);

// The cursor starts after the prompt.
place_cursor(framebuffer, 3, 5);

// Read three pixels back out of the device's memory. Drawing that nobody can
// see is indistinguishable from drawing that never happened, and a headless
// machine has no other way to tell.
// The background, and a pixel inside the title's first glyph (`L`, whose
// top-left is lit).
let empty = get_pixel(framebuffer, WIDTH, WIDTH - 1, HEIGHT - 1);
let title = get_pixel(framebuffer, WIDTH, 6, 8);

// A critical section, written in LK. The handlers transmit on the same device
// these lines do, and an interrupt lands between any two instructions — so
// without masking, a tick would splice a '.' into the middle of a message.
// `cpu_irq_save` returns the previous state rather than a flag, so nesting one
// of these inside another does not enable interrupts early on the way out.
let irq = unsafe { cpu_irq_save() };
// "display at pci slot "
uart_write([100, 105, 115, 112, 108, 97, 121, 32, 97, 116, 32, 112, 99, 105, 32,
            115, 108, 111, 116, 32]);
uart_put_int(slot);
uart_putc(10);
// "framebuffer 0x"
uart_write([102, 114, 97, 109, 101, 98, 117, 102, 102, 101, 114, 32, 48, 120]);
uart_put_hex(framebuffer);
uart_putc(10);
// "pixels "
uart_write([112, 105, 120, 101, 108, 115, 32]);
uart_put_hex(empty);
uart_putc(32);
uart_put_hex(title);
uart_putc(10);
unsafe { cpu_irq_restore(irq); };

// The shell loop.
//
// `cpu_wait_for_interrupt` parks the core instead of spinning: on a real board
// that is the difference between idling and burning a watt, and on a
// virtualised one it stops starving the sibling. The handler wakes it, and
// raises a flag when a line is complete.
//
// The bound counts *interrupts*, not milliseconds — a keystroke is two of them
// and a scroll delays the next tick — so it is generous rather than exact. Its
// job is only to make an unattended board finish.
let running = 1;
let waited = 0;
while (running == 1 && waited < 60000) {
    unsafe { cpu_wait_for_interrupt(); };
    waited = waited + 1;

    // Repaint the frame when the focus has moved. Cheap enough to check every
    // wake; the drawing only happens when the answer changed.
    let seen_focus = shared_read(SHARED_DRAWN_FOCUS);
    let focus_now = shared_read(SHARED_FOCUS);
    if (seen_focus != focus_now) {
        let irq_frame = lock();
        repaint_frame(framebuffer, WINDOW_SHELL);
        repaint_frame(framebuffer, WINDOW_SPINNER);
        shared_write(SHARED_DRAWN_FOCUS, focus_now);
        unlock(irq_frame);
    }

    // Drain whatever the handler routed here. Building the line is this
    // window's business now, not the handler's: the handler does not know
    // what a keystroke means, only who it belongs to.
    let irq_in = lock();
    while (!queue_empty(SHARED_QUEUES + WINDOW_SHELL * QUEUE_STRIDE)) {
        let ascii = queue_pop(SHARED_QUEUES + WINDOW_SHELL * QUEUE_STRIDE);
        let length = shared_read(SHARED_LINE_LEN);
        if (ascii == 10) {
            shared_write(SHARED_LINE_READY, 1);
        } else {
            if (ascii == 8) {
                if (length > 0) {
                    shared_write(SHARED_LINE_LEN, length - 1);
                }
            } else {
                if (length < LINE_CAPACITY) {
                    shared_write_byte(SHARED_LINE + length, ascii);
                    shared_write(SHARED_LINE_LEN, length + 1);
                }
            }
        }
        put_char(framebuffer, ascii);
    }
    unlock(irq_in);

    if (shared_read(SHARED_LINE_READY) == 1) {
        // Mask around the whole exchange: the handler shares the cursor and
        // the line buffer, and a keystroke arriving mid-command would splice
        // its echo into the output and its byte into the next line.
        let irq = unsafe { cpu_irq_save() };
        running = run_command(framebuffer);
        shared_write(SHARED_LINE_LEN, 0);
        shared_write(SHARED_LINE_READY, 0);
        if (running == 1) {
            // "> "
            uart_putc(62);
            put_char(framebuffer, 62);
        }
        unsafe { cpu_irq_restore(irq); };
    }
}

let keys = shared_read(SHARED_KEY_COUNT);
let last = shared_read(SHARED_LAST_KEY);

// Masked and deliberately not restored: what runs after this is the runtime's
// epilogue echoing the script's value, which no LK code is in a position to
// protect.
unsafe { cpu_irq_save(); };
uart_putc(10);
// "keys "
uart_write([107, 101, 121, 115, 32]);
uart_put_int(keys);
// " last "
uart_write([32, 108, 97, 115, 116, 32]);
uart_put_int(last);
uart_putc(10);

return keys;
