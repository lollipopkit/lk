// Struct syntax demo

// Define a struct (types optional; unannotated fields are treated as Any)
struct User { id: Int, name: String?, active: Bool }

// Instantiate using struct literal
let u1 = User { id: 1, name: "Ann", active: true };
let u2 = User { id: 2, active: false }; // name is optional

println("u1.id={}, u1.name={}, u1.active={}", u1.id, u1.name, u1.active);
println("u2.id={}, u2.name={}, u2.active={}", u2.id, u2.name, u2.active);

// Constructor fallback using literal syntax
let u3 = User { id: 3, name: "Bob", active: true };
println("u3.id={}, u3.name={}, u3.active={}", u3.id, u3.name, u3.active);

// Struct update (`{ ..base, field: value }`) keeps the *declared* field order,
// like every other way of building the type. It printed the hash map's own
// order instead, so the same struct rendered two ways depending on which syntax
// built it — and the interpreter and the compiled build disagreed about which.
// Six fields, deliberately: with fewer, the two orders can coincide.
struct Reading { zebra: Int, apple: Int, mango: Int, kiwi: Int, pear: Int, fig: Int }
let base = Reading { zebra: 1, apple: 2, mango: 3, kiwi: 4, pear: 5, fig: 6 };
let shown = "{}".format(base);
assert(shown == "Reading{zebra:1,apple:2,mango:3,kiwi:4,pear:5,fig:6}");
let bumped = Reading { ..base, apple: 99 };
assert("{}".format(bumped) == "Reading{zebra:1,apple:99,mango:3,kiwi:4,pear:5,fig:6}");
assert(bumped.apple == 99);
assert(bumped.zebra == 1);

return;

// A field's declared type is what a read of it produces.
//
// The storage is a string-keyed map, so a field read is a boxed value and
// knows nothing about the declaration — `p.count + 1` boxed both operands and
// called the dynamic add for a field the program plainly said was an `Int`.
// The declared type travels with the field name in the module's type info now,
// so the read narrows to it and the arithmetic around it stays machine
// arithmetic.
struct Sample { at: Int, value: Float, sensor: String }

fn newer(a: Sample, b: Sample) -> Int {
    if a.at > b.at { return a.at; }
    return b.at;
}
let first = Sample { at: 10, value: 1.5, sensor: "a" };
let second = Sample { at: 4, value: 2.5, sensor: "b" };
assert(newer(first, second) == 10);
assert(first.value + second.value == 4.0);
assert(first.sensor + second.sensor == "ab");

// Through a list of them, which is where the identity used to stop: an element
// read gave a value the lowering had no name for, so the declared field type
// could not be applied to it.
let readings = [first, second];
assert(readings[0].at == 10);
assert(readings[1].at + 1 == 5);
let total = 0;
for r in readings { total = total + r.at; }
assert(total == 14);
